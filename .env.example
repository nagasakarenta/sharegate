# Nebius Token Factory (OpenAI-compatible). Leave NEBIUS_API_KEY empty to run in mock mode.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Check the exact IDs with: uv run python scripts/list_models.py
MODEL_NANO=nvidia/nemotron-3-nano-30b-a3b
MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
MODEL_ULTRA=nvidia/nemotron-3-ultra-550b-a55b
# Path to Chrome for PDF export (macOS default below)
CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
